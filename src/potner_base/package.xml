<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>potner_base</name>
  <version>0.1.0</version>
  <description>로봇 하드웨어 계층 — ESP32 시리얼 통신, 차동 구동 기구학과 오도메트리, I2C 식물·배터리 센서, 표정 화면</description>
  <maintainer email="notbad1700@gmail.com">E104</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-smbus2</exec_depend>
  <!-- face_display 가 씁니다. 젯팩에 이미 깔려 있어 동작에는 지장이
       없었지만, rosdep 으로 새 기기를 세팅하면 여기 없는 의존성은
       설치되지 않습니다. -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
