# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.  cp .env.local.example .env.local
# .env.local 은 .gitignore 에 있어 커밋되지 않습니다.

# ─────────────────────────────────────────────────────────────────────
# 방법 A (권장, 지금 바로 동작): SSAFY GMS 게이트웨이 경유
# ─────────────────────────────────────────────────────────────────────
# 저장소 루트 .env 의 GMS_API_KEY 와 같은 값을 그대로 넣으면 됩니다.
# 변수명은 GMS_API_KEY로 통일했습니다 — potner_llm(로봇, OpenAI 프록시)도 같은 이름을
# 폴백으로 지원해서, 키 하나를 두 프로젝트 .env 파일에 같은 이름으로 복사해 두면 됩니다.
# GMS가 api.anthropic.com 을 프록시하고 GMS 키를 x-api-key 로 받는 것을 실측 확인했습니다.
GMS_API_KEY=
ANTHROPIC_BASE_URL=https://gms.ssafy.io/gmsapi/api.anthropic.com

# GMS allowlist에 있는 모델만 씁니다 (실측):
#   claude-opus-4-8  (기본값, 가장 강력)
#   claude-opus-4-7
#   claude-opus-4-6
#   claude-sonnet-4-6  (더 빠르고 저렴)
# claude-opus-5 / claude-sonnet-5 는 GMS allowlist에 아직 없어 400이 납니다.
ANTHROPIC_MODEL=claude-opus-4-8

# ─────────────────────────────────────────────────────────────────────
# 방법 B: Anthropic 직접 (sk-ant-... 키가 따로 있는 경우)
# ─────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...  (GMS_API_KEY보다 이 이름이 우선 적용됩니다)
# ANTHROPIC_BASE_URL 은 지우거나 비워두세요 (SDK 기본값 사용)
# ANTHROPIC_MODEL=claude-opus-5

# ─────────────────────────────────────────────────────────────────────
# 로봇(하드웨어) 센서 값 수신 — POST /api/sensor 인증용 공유 비밀키
# ─────────────────────────────────────────────────────────────────────
# 비워두면 /api/sensor 가 모든 요청을 401로 거부합니다(오픈 엔드포인트 방지).
# 로봇 쪽에서 이 값을 X-Sensor-Key 헤더에 그대로 실어 보내면 됩니다.
SENSOR_INGEST_KEY=
